{
  "name": "workshopper",
  "private": true,
  "description": "p5.js でプログラミングの基礎を学ぶワークショップ教材アプリ",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vp build",
    "cf-typegen": "wrangler types",
    "check": "vp check && vp build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "vp dev",
    "lint": "vp lint",
    "preview": "pnpm run build && vp preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@mdx-js/rollup": "^3.1.1",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.159.0"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.34.9"
}
