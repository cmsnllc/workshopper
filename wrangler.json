{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workshopper",
  "main": "./+server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "html_handling": "none",
